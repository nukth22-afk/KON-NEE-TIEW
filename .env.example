# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for sitemap.xml and SEO metadata).
APP_URL="MY_APP_URL"

# Optional comma-separated list of Admin Google Account emails for /admin access
ADMIN_EMAIL=""

# Cloud SQL PostgreSQL runtime variables (automatically injected by AI Studio Cloud SQL)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
